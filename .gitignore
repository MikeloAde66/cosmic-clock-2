# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local archive of non-media files pulled out of public/assets (never web-servable, never committed)
/_local-archive/

# unreferenced local media dump — nothing in app code links to these; never committed
/public/assets/

# scratch project with its own node_modules, unrelated to this app
/sat-test/

# python (quantum-service/ and its own venv/ — the venv also self-ignores
# via a .gitignore python -m venv generates inside it, this covers stray
# __pycache__ dirs elsewhere, e.g. quantum-service/'s own root)
__pycache__/
*.pyc

# typescript
*.tsbuildinfo
next-env.d.ts
